{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p review-room/motion/codex && python3 - <<'PY'\nfrom __future__ import annotations\n\nimport json\nimport os\nimport pathlib\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\nfrom typing import Any\n\nfrom video_claw import keys\nfrom video_claw.cache import Cache\nfrom video_claw.lipsync import fal_upload_file\n\nROOT = pathlib.Path.cwd()\nSTILLS = ROOT / \\\"review-room\\\" / \\\"stills\\\"\nOUT_DIR = ROOT / \\\"review-room\\\" / \\\"motion\\\" / \\\"codex\\\"\nTMP_DIR = OUT_DIR / \\\".tmp\\\"\nTMP_DIR.mkdir(parents=True, exist_ok=True)\n\nMODEL = \\\"fal-ai/kling-video/v3/pro/image-to-video\\\"\nQUEUE_URL = f\\\"https://queue.fal.run/{MODEL}\\\"\nFAL_KEY = keys.get(\\\"FAL_API_KEY\\\")\nif not FAL_KEY:\n    raise SystemExit(\\\"No FAL_API_KEY available\\\")\n\nGLOBAL_STYLE = (\n    \\\"cinematic prestige-TV office drama, Severance-adjacent, teal-and-amber color grade, \\\"\n    \\\"shallow depth of field, film grain, moody volumetric lighting, photorealistic, \\\"\n    \\\"fully human cast, ~25-30 years old.\\\"\n)\nGLOBAL_NEGATIVE = (\n    \\\"no on-screen text, no captions, no watermark, no real company logos or brand marks, \\\"\n    \\\"no morphing or distorting faces, no extra limbs, no robots, no cartoon look.\\\"\n)\n\nSHOTS = [\n    {\n        \\\"num\\\": \\\"01\\\",\n        \\\"duration\\\": 6,\n        \\\"camera\\\": \\\"slow push-in down the corridor; the glass review room glows; faint people-shift in the queued tribes.\\\",\n        \\\"prompt\\\": \\\"Slowly push in down a modern office corridor toward a glowing glass-walled executive review room at the end. Groups of young human agents in blue, charcoal and rust uniform shirts wait along the hall, shifting and murmuring nervously. Subtle volumetric light, slow drifting dust. Tense calm-before-the-room atmosphere.\\\",\n    },\n    {\n        \\\"num\\\": \\\"02\\\",\n        \\\"duration\\\": 5,\n        \\\"camera\\\": \\\"slight handheld drift around the huddle; agents gesture and whisper; faint holographic annotation/redline marks flicker near the tablet.\\\",\n        \\\"prompt\\\": \\\"A tight huddle of young agents in mixed blue/charcoal/rust shirts lean over a glowing tablet, whispering and pointing, critiquing a presentation. Faint translucent annotation marks and red redline scribbles flicker in the air between them. Anxious, collaborative energy. Subtle handheld camera drift.\\\",\n    },\n    {\n        \\\"num\\\": \\\"03\\\",\n        \\\"duration\\\": 4,\n        \\\"camera\\\": \\\"macro; a thumb swipes the slide; redline marks animate in then settle.\\\",\n        \\\"prompt\\\": \\\"Extreme close-up of a young rust-shirted hand holding a glowing tablet; a thumb swipes to the next clean presentation slide; faint holographic red annotation marks animate in and settle. Soft bokeh of agents behind. Shallow focus.\\\",\n    },\n    {\n        \\\"num\\\": \\\"04\\\",\n        \\\"duration\\\": 4,\n        \\\"camera\\\": \\\"the agent steps through the glass door; camera follows past the threshold; the backlit executive turns slightly.\\\",\n        \\\"prompt\\\": \\\"A young rust-shirted agent pushes through a glass door into a bright executive review room; the camera follows them across the threshold. At the table, a backlit executive in silhouette turns slightly toward them. Anticipation, held breath.\\\",\n    },\n    {\n        \\\"num\\\": \\\"06\\\",\n        \\\"duration\\\": 3,\n        \\\"camera\\\": \\\"static-ish; the executive gives a slow, weighing nod; foreground silhouette breathes.\\\",\n        \\\"prompt\\\": \\\"Over-the-shoulder on a silhouetted executive who gives a slow, considered, weighing nod. Beyond, a young agent watches hopefully, anxious. Minimal motion, maximum tension. Shallow depth of field.\\\",\n    },\n    {\n        \\\"num\\\": \\\"08\\\",\n        \\\"duration\\\": 4,\n        \\\"camera\\\": \\\"a soft green glow blooms across the agent's chest insignia and face; relief breaks; a held breath releases.\\\",\n        \\\"prompt\\\": \\\"Extreme close-up: a soft green glow of approval blooms across a young agent's chest insignia and face; relief and a small smile break through; their held breath releases. Warm green light briefly washing the cold tones.\\\",\n    },\n    {\n        \\\"num\\\": \\\"09\\\",\n        \\\"duration\\\": 6,\n        \\\"camera\\\": \\\"two groups cross at the glass doorway; the rejected agent's red 'sent-back' marker pulses; relieved agents pass smiling.\\\",\n        \\\"prompt\\\": \\\"At a glass doorway, a group of young agents exits - most relieved and smiling - while one, holding a pulsing red 'sent-back' marker, walks out dejected, passing a nervous group entering. Mixed blue/charcoal/rust shirts. Crossing foot-traffic, natural motion, emotional contrast.\\\",\n    },\n    {\n        \\\"num\\\": \\\"10\\\",\n        \\\"duration\\\": 7,\n        \\\"camera\\\": \\\"slow dolly back revealing the full corridor of tribes; inside, the executive resolves into a lone founder; scrolling terminal/code text reflects and drifts across the glass.\\\",\n        \\\"prompt\\\": \\\"Slow dolly back along a long corridor packed with young tribe-colored agents toward a glowing glass review room. Inside, the executive silhouette is revealed as a single lone founder at the table; faint scrolling terminal/code text reflects and drifts across the glass, blurring human and machine. Epic, intimate, aspirational pull-back.\\\",\n    },\n]\n\n\ndef request_json(url: str, *, method: str = \\\"GET\\\", body: dict[str, Any] | None = None, timeout: int = 120) -> dict[str, Any]:\n    data = None if body is None else json.dumps(body).encode(\\\"utf-8\\\")\n    headers = {\\\"Authorization\\\": f\\\"Key {FAL_KEY}\\\"}\n    if body is not None:\n        headers[\\\"Content-Type\\\"] = \\\"application/json\\\"\n    req = urllib.request.Request(url, data=data, headers=headers, method=method)\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            text = r.read().decode(\\\"utf-8\\\")\n            return json.loads(text) if text else {}\n    except urllib.error.HTTPError as e:\n        detail = e.read().decode(\\\"utf-8\\\", errors=\\\"ignore\\\")[:1000]\n        raise RuntimeError(f\\\"HTTP {e.code} from {url}: {detail}\\\") from e\n\n\ndef download(url: str, dest: pathlib.Path) -> None:\n    req = urllib.request.Request(url, headers={\\\"User-Agent\\\": \\\"video-claw-codex/1.0\\\"})\n    with urllib.request.urlopen(req, timeout=600) as r, dest.open(\\\"wb\\\") as f:\n        while True:\n            chunk = r.read(1024 * 1024)\n            if not chunk:\n                break\n            f.write(chunk)\n\n\ndef normalize(raw: pathlib.Path, out: pathlib.Path, duration: int) -> None:\n    tmp = out.with_suffix(\\\".normalized.tmp.mp4\\\")\n    if tmp.exists():\n        tmp.unlink()\n    cmd = [\n        \\\"ffmpeg\\\", \\\"-y\\\", \\\"-hide_banner\\\", \\\"-loglevel\\\", \\\"error\\\",\n        \\\"-i\\\", str(raw),\n        \\\"-t\\\", str(duration),\n        \\\"-vf\\\", \\\"scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=30,format=yuv420p\\\",\n        \\\"-an\\\",\n        \\\"-c:v\\\", \\\"libx264\\\", \\\"-preset\\\", \\\"medium\\\", \\\"-crf\\\", \\\"18\\\",\n        \\\"-movflags\\\", \\\"+faststart\\\",\n        str(tmp),\n    ]\n    subprocess.run(cmd, check=True)\n    tmp.replace(out)\n\n\ndef probe(path: pathlib.Path) -> str:\n    cmd = [\n        \\\"ffprobe\\\", \\\"-v\\\", \\\"error\\\",\n        \\\"-select_streams\\\", \\\"v:0\\\",\n        \\\"-show_entries\\\", \\\"stream=width,height,avg_frame_rate:format=duration\\\",\n        \\\"-of\\\", \\\"json\\\", str(path),\n    ]\n    data = json.loads(subprocess.check_output(cmd, text=True))\n    stream = data[\\\"streams\\\"][0]\n    dur = float(data[\\\"format\\\"][\\\"duration\\\"])\n    return f'{stream[\\\"width\\\"]}x{stream[\\\"height\\\"]} {stream[\\\"avg_frame_rate\\\"]} duration={dur:.2f}s'\n\n\nprint(f\\\"Using fal.ai endpoint: {MODEL}\\\", flush=True)\ncache = Cache(ROOT / \\\"review-room\\\" / \\\"work\\\")\nuploads: dict[str, str] = {}\nfor shot in SHOTS:\n    num = shot[\\\"num\\\"]\n    still = STILLS / f\\\"shot_{num}.png\\\"\n    if not still.exists():\n        raise RuntimeError(f\\\"Missing seed still {still}\\\")\n    print(f\\\"Uploading seed shot_{num}.png\\\", flush=True)\n    uploads[num] = fal_upload_file(still, cache=cache)\n\njobs: dict[str, dict[str, Any]] = {}\nfor shot in SHOTS:\n    num = shot[\\\"num\\\"]\n    final_prompt = (\n        f\\\"Camera/motion: {shot['camera']} Prompt: {shot['prompt']} \\\"\n        f\\\"Style: {GLOBAL_STYLE}\\\"\n    )\n    body = {\n        \\\"prompt\\\": final_prompt,\n        \\\"start_image_url\\\": uploads[num],\n        \\\"duration\\\": str(shot[\\\"duration\\\"]),\n        \\\"generate_audio\\\": False,\n        \\\"negative_prompt\\\": GLOBAL_NEGATIVE,\n        \\\"cfg_scale\\\": 0.5,\n    }\n    print(f\\\"Submitting shot_{num} ({shot['duration']}s)\\\", flush=True)\n    submitted = request_json(QUEUE_URL, method=\\\"POST\\\", body=body, timeout=120)\n    request_id = submitted.get(\\\"request_id\\\")\n    if not request_id:\n        raise RuntimeError(f\\\"No request_id for shot_{num}: {submitted}\\\")\n    jobs[num] = {\n        \\\"shot\\\": shot,\n        \\\"request_id\\\": request_id,\n        \\\"status_url\\\": submitted.get(\\\"status_url\\\") or f\\\"{QUEUE_URL}/requests/{request_id}/status\\\",\n        \\\"response_url\\\": submitted.get(\\\"response_url\\\") or f\\\"{QUEUE_URL}/requests/{request_id}\\\",\n        \\\"last_status\\\": None,\n    }\n    print(f\\\"Queued shot_{num}: {request_id}\\\", flush=True)\n\npending = set(jobs.keys())\nstarted = time.time()\nwhile pending:\n    for num in list(pending):\n        job = jobs[num]\n        status_url = job[\\\"status_url\\\"]\n        sep = \\\"&\\\" if \\\"?\\\" in status_url else \\\"?\\\"\n        status = request_json(status_url + f\\\"{sep}logs=1\\\", timeout=120)\n        state = status.get(\\\"status\\\")\n        if state \"'!= job.get(\"last_status\"):\n            extra = \"\"\n            if \"queue_position\" in status:\n                extra = f\" position={status['\"'queue_position']}\\\"\n            print(f\\\"shot_{num} status={state}{extra}\\\", flush=True)\n            job[\\\"last_status\\\"] = state\n        if state == \\\"COMPLETED\\\":\n            if status.get(\\\"error\\\"):\n                raise RuntimeError(f\\\"shot_{num} failed: {status.get('error_type')}: {status.get('error')}\\\")\n            result = request_json(job[\\\"response_url\\\"], timeout=120)\n            video = result.get(\\\"video\\\") or (result.get(\\\"data\\\") or {}).get(\\\"video\\\")\n            if not video or not video.get(\\\"url\\\"):\n                raise RuntimeError(f\\\"shot_{num} completed without video URL: {result}\\\")\n            raw = TMP_DIR / f\\\"shot_{num}.raw.mp4\\\"\n            out = OUT_DIR / f\\\"shot_{num}.mp4\\\"\n            print(f\\\"Downloading shot_{num} result\\\", flush=True)\n            download(video[\\\"url\\\"], raw)\n            print(f\\\"Normalizing shot_{num} to {out.relative_to(ROOT)}\\\", flush=True)\n            normalize(raw, out, int(job[\\\"shot\\\"][\\\"duration\\\"]))\n            info = probe(out)\n            print(f\\\"DONE shot_{num}: {out} ({info})\\\", flush=True)\n            pending.remove(num)\n    if pending:\n        elapsed = int(time.time() - started)\n        print(f\\\"Waiting on {len(pending)} shot(s): {', '.join('shot_'+n for n in sorted(pending))} elapsed={elapsed}s\\\", flush=True)\n        time.sleep(15)\n\nprint(\\\"All requested motion shots generated.\\\", flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
