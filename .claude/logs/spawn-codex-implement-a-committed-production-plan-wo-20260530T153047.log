{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom PIL import Image, ImageDraw, ImageFont\n\noutdir = Path('review-room/stills')\nfont_candidates = [\n    '/System/Library/Fonts/Supplemental/Arial.ttf',\n    '/System/Library/Fonts/Supplemental/Helvetica.ttf',\n    '/System/Library/Fonts/Helvetica.ttc',\n]\nfont = None\nfor fp in font_candidates:\n    try:\n        font = ImageFont.truetype(fp, 110)\n        break\n    except Exception:\n        pass\nif font is None:\n    font = ImageFont.load_default()\n\nfor n in range(3, 11):\n    img = Image.new('RGB', (1920, 1080), (12, 15, 20))\n    draw = ImageDraw.Draw(img)\n    label = f'SHOT {n:02d}'\n    bbox = draw.textbbox((0, 0), label, font=font)\n    tw, th = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    x, y = (1920 - tw) // 2, (1080 - th) // 2\n    draw.rectangle((x - 70, y - 45, x + tw + 70, y + th + 55), outline=(90, 110, 130), width=3)\n    draw.text((x, y), label, fill=(245, 248, 252), font=font)\n    img.save(outdir / f'shot_{n:02d}.png')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
