{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nfrom PIL import Image, ImageDraw, ImageFont\n\nroot = Path('review-room/work')\ntimes = [3, 12, 30, 44, 52, 58]\npaths = [root / f'check_{t}.png' for t in times]\nfont_candidates = [\n    '/System/Library/Fonts/Supplemental/Arial.ttf',\n    '/System/Library/Fonts/Helvetica.ttc',\n]\nfont = None\nfor fp in font_candidates:\n    try:\n        font = ImageFont.truetype(fp, 26)\n        break\n    except Exception:\n        pass\nif font is None:\n    font = ImageFont.load_default()\nthumb_w, thumb_h = 480, 270\nlabel_h = 42\nsheet = Image.new('RGB', (thumb_w * 3, (thumb_h + label_h) * 2), (12, 15, 20))\ndraw = ImageDraw.Draw(sheet)\nfor idx, (t, p) in enumerate(zip(times, paths)):\n    im = Image.open(p).convert('RGB').resize((thumb_w, thumb_h), Image.LANCZOS)\n    x = (idx % 3) * thumb_w\n    y = (idx // 3) * (thumb_h + label_h)\n    sheet.paste(im, (x, y + label_h))\n    draw.text((x + 14, y + 9), f't={t}s  {p.name}', fill=(245, 248, 252), font=font)\nsheet.save(root / 'check_contact_sheet.png')\nprint(root / 'check_contact_sheet.png')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
