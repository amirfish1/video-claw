{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python3 -u - <<'PY'\nfrom __future__ import annotations\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nimport urllib.error\nimport urllib.request\nfrom pathlib import Path\n\nfrom video_claw.cache import Cache\nfrom video_claw.lipsync import fal_upload_file\nfrom video_claw import keys\n\nROOT = Path('/Users/amirfish/Apps/video-claw')\nOUT_DIR = ROOT / 'review-room' / 'raw'\nENDPOINT = 'fal-ai/kling-video/v3/pro/image-to-video'\nAPI_KEY = keys.get('FAL_API_KEY')\nif not API_KEY:\n    raise SystemExit('FAL_API_KEY is not configured')\n\ncache = Cache(ROOT)\nOUT_DIR.mkdir(parents=True, exist_ok=True)\n\nJOBS = [\n    {\n        'name': 'founder_motion.mp4',\n        'seed': ROOT / 'review-room/v1.5/owned/altframes-codex/vp_founder.png',\n        'prompt': 'Preserve the exact same founder, colleagues, clothing, bright meeting-room table, lighting, camera angle, and composition from the seed image; no scene cuts, no new people, no character or room changes. The warm friendly founder reviews marketing pages at a bright meeting-room table with two colleagues; he nods thoughtfully, glances down then up with an approving engaged expression; subtle natural motion; gentle slow camera.',\n    },\n    {\n        'name': 'debate_personA.mp4',\n        'seed': ROOT / 'review-room/raw/seed_debate_A.png',\n        'prompt': 'Preserve the exact same young colleague, clothing, office setting, daylight, camera angle, and composition from the seed image; no scene cuts, no new people, no character or room changes. A young colleague mid-debate makes their point, talking and gesturing with conviction, leaning in; natural office daylight, handheld feel.',\n    },\n    {\n        'name': 'debate_personB.mp4',\n        'seed': ROOT / 'review-room/raw/seed_debate_B.png',\n        'prompt': 'Preserve the exact same young colleague, clothing, office setting, daylight, camera angle, and composition from the seed image; no scene cuts, no new people, no character or room changes. The other young colleague responds in the debate: listens, a small disagreeing head-shake, then counters while talking and gesturing; natural office daylight.',\n    },\n]\n\n\ndef http_json(req: urllib.request.Request, timeout: int):\n    try:\n        with urllib.request.urlopen(req, timeout=timeout) as r:\n            return json.load(r)\n    except urllib.error.HTTPError as e:\n        body = e.read().decode(errors='replace')\n        raise RuntimeError(f'HTTP {e.code}: {body}') from None\n\n\ndef submit_kling(start_image_url: str, prompt: str) -> dict:\n    body = {\n        'start_image_url': start_image_url,\n        'prompt': prompt,\n        'duration': '5',\n        'generate_audio': False,\n        'negative_prompt': 'blur, distort, low quality, scene cut, new character, changed face, changed clothing, different room, extra people, subtitles, text overlay',\n        'cfg_scale': 0.5,\n    }\n    req = urllib.request.Request(\n        f'https://queue.fal.run/{ENDPOINT}',\n        data=json.dumps(body).encode(),\n        headers={\n            'Authorization': f'Key {API_KEY}',\n            'Content-Type': 'application/json',\n        },\n    )\n    return http_json(req, 60)\n\n\ndef poll_job(job_name: str, sub: dict, budget_seconds: int = 1800) -> dict:\n    request_id = sub.get('request_id')\n    status_url = sub.get('status_url')\n    response_url = sub.get('response_url')\n    if not request_id or not status_url or not response_url:\n        raise RuntimeError(f'fal submit returned unexpected payload: {sub}')\n    print(f'[{job_name}] queued request_id={request_id}', flush=True)\n    deadline = time.time() + budget_seconds\n    last_status = None\n    last_log = None\n    while time.time() < deadline:\n        time.sleep(10)\n        req = urllib.request.Request(status_url, headers={'Authorization': f'Key {API_KEY}'})\n        st = http_json(req, 60)\n        status = st.get('status')\n        logs = st.get('logs') or []\n        log_msg = None\n        if logs and isinstance(logs[-1], dict):\n            log_msg = logs[-1].get('message')\n        if status \"'!= last_status or log_msg != last_log:\n            if log_msg:\n                print(f'\"'[{job_name}] status={status} log={log_msg}', flush=True)\n            else:\n                qpos = st.get('queue_position')\n                extra = f' queue_position={qpos}' if qpos is not None else ''\n                print(f'[{job_name}] status={status}{extra}', flush=True)\n            last_status = status\n            last_log = log_msg\n        if status == 'COMPLETED':\n            rreq = urllib.request.Request(response_url, headers={'Authorization': f'Key {API_KEY}'})\n            return http_json(rreq, 120)\n        if status in ('FAILED', 'CANCELLED'):\n            raise RuntimeError(f'fal {status}: {json.dumps(st, ensure_ascii=False)}')\n    raise RuntimeError(f'fal timed out after {budget_seconds}s: request_id={request_id}')\n\n\ndef download(url: str, dest: Path):\n    req = urllib.request.Request(url)\n    with urllib.request.urlopen(req, timeout=600) as r:\n        dest.write_bytes(r.read())\n\n\ndef normalize(src: Path, out_path: Path):\n    tmp = out_path.with_suffix(out_path.suffix + '.tmp.mp4')\n    if tmp.exists():\n        tmp.unlink()\n    cmd = [\n        'ffmpeg', '-y', '-hide_banner', '-loglevel', 'error',\n        '-i', str(src),\n        '-map', '0:v:0',\n        '-vf', 'scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080,fps=30,setsar=1',\n        '-c:v', 'libx264', '-preset', 'medium', '-crf', '18',\n        '-pix_fmt', 'yuv420p', '-movflags', '+faststart',\n        '-an', str(tmp),\n    ]\n    subprocess.run(cmd, check=True, cwd=str(ROOT))\n    os.replace(tmp, out_path)\n\n\nfailures = []\nfor job in JOBS:\n    name = job['name']\n    seed = job['seed']\n    out_path = OUT_DIR / name\n    source_path = OUT_DIR / f'.{out_path.stem}.fal-source.mp4'\n    try:\n        if not seed.exists():\n            raise RuntimeError(f'seed image missing: {seed}')\n        print(f'[{name}] uploading seed: {seed}', flush=True)\n        start_url = fal_upload_file(seed, cache=cache)\n        print(f'[{name}] uploaded seed_url={start_url}', flush=True)\n        sub = submit_kling(start_url, job['prompt'])\n        result = poll_job(name, sub)\n        video = result.get('video')\n        video_url = video.get('url') if isinstance(video, dict) else video\n        if not video_url:\n            raise RuntimeError(f'fal returned no video url: {json.dumps(result, ensure_ascii=False)}')\n        print(f'[{name}] downloading generated video', flush=True)\n        download(video_url, source_path)\n        print(f'[{name}] normalizing to 1920x1080 30fps, audio disabled', flush=True)\n        normalize(source_path, out_path)\n        print(f'LANDED {out_path}', flush=True)\n    except Exception as e:  # noqa: BLE001\n        msg = str(e)\n        failures.append((name, msg))\n        print(f'FAL_ERROR {name}: {msg}', flush=True)\n\nprint('SUMMARY_START', flush=True)\nfor job in JOBS:\n    out_path = OUT_DIR / job['name']\n    print(f'{job[\\\"name\\\"]}: exists={out_path.exists()} path={out_path}', flush=True)\nif failures:\n    print('FAILURES:', flush=True)\n    for name, msg in failures:\n        print(f'{name}: {msg}', flush=True)\n    raise SystemExit(1)\nprint('SUMMARY_END', flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
